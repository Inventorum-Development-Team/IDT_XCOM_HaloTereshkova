alienMissions:
####################################################
######  PHASE 1: INSURRECTIONIST UPRISING  #########
####################################################

  - type: STR_INSURGENT_RAID # Innies strike civilian and UNSC infrastructure
    points: 10
    objective: 3
    siteType: STR_INSURGENT_RAID_SITE
    spawnZone: 3
    raceWeights:
      0:
        STR_INSURGENTS: 100
    waves:
      - ufo: STR_INSURGENT_RAID_SITE
        count: 1
        trajectory: STATIC_TRAJECTORY
        timer: 0
        objective: true

  - type: STR_INSURGENT_SUPPLY_INTERDICTION # Innies ambush a UNSC supply convoy
    points: 15
    objective: 3
    siteType: STR_INSURGENT_CONVOY_AMBUSH
    spawnZone: 3
    raceWeights:
      0:
        STR_INSURGENTS: 100
    waves:
      - ufo: STR_INSURGENT_CONVOY_AMBUSH
        count: 1
        trajectory: STATIC_TRAJECTORY
        timer: 0
        objective: true

####################################################
######  PHASE 2: EARLY COVENANT CONTACT  ###########
####################################################

  - type: STR_COVENANT_QUICK_SECTOR_INVASION # Covenant sneaks one base early
    points: 100 # Pact score only awarded on month end
    objective: 1
    siteType: STR_COVENANT_SPIRE_DEPLOYMENT
    spawnZone: 4 # Mission zone for alien bases
    endlessInfiltration: false
    raceWeights:
      0:
        STR_SANGHEILI_LANCE: 100
    waves:
      - ufo: STR_SDV_CLASS_HEAVY_CORVETTE
        count: 1
        trajectory: P2
        timer: 100

  - type: STR_COVENANT_RECON
    points: 10
    objective: 0
    raceWeights:
      0:
        STR_SANGHEILI_LANCE: 60
        STR_STANDARD_LANCE: 40
    waves:
      - ufo: STR_SPIRIT_DROPSHIP
        count: 1
        trajectory: P2
        timer: 3200
      - ufo: STR_BANSHEE_FIGHTER
        count: 3
        trajectory: P1
        timer: 3200
        escort: true

  - type: STR_COVENANT_AIR_SUPERIORITY_1
    points: 1
    objective: 0
    raceWeights:
      0:
        STR_SANGHEILI_LANCE: 100
    waves:
      - ufo: STR_SPIRIT_DROPSHIP
        count: 1
        trajectory: P2
        timer: 1440
        huntMode: 0
      - ufo: STR_SERAPH_FIGHTER
        count: 3
        trajectory: P2
        timer: 5000
        huntMode: 1

  - type: STR_COVENANT_FIRST_CONTACT_TERROR # Probing terror attack, lighter than city assault
    points: 20
    objective: 3
    siteType: STR_TERROR_MISSION
    spawnZone: 3
    raceWeights:
      0:
        STR_SANGHEILI_LANCE: 50
        STR_STANDARD_LANCE: 50
    waves:
      - ufo: STR_SPIRIT_DROPSHIP
        count: 1
        trajectory: P1
        timer: 1440
      - ufo: STR_BANSHEE_FIGHTER
        count: 2
        trajectory: P1
        timer: 1440
        escort: true

####################################################
######  PHASE 3: COVENANT ESCALATION  ##############
####################################################

  - type: STR_COVENANT_SECTOR_INVASION_EARLY # Covenant attempts to overrun UNSC regional commands
    points: 100 # Pact score only awarded on month end
    objective: 1
    siteType: STR_COVENANT_SPIRE_DEPLOYMENT
