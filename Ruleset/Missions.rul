        count: 1
        trajectory: P2
        timer: 7200
      - ufo: STR_CCS_CLASS_BATTLECRUISER
        count: 1
        trajectory: P7
        timer: 7200

  - type: STR_COVENANT_AIR_SUPERIORITY_2
    points: 1
    objective: 0
    raceWeights:
      0:
        STR_SANGHEILI_LANCE: 100
    waves:
      - ufo: STR_SDV_CLASS_HEAVY_CORVETTE
